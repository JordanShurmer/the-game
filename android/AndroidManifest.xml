<?xml version="1.0" encoding="utf-8"?>
<!-- The APK holds no game code. It holds the page, and a WebView that
     serves it. See docs/web.md, "The APK".

     The package name is an example, on purpose: change it before this
     goes anywhere but your own phone. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	package="com.example.thegame"
	android:versionCode="1"
	android:versionName="0.1">

	<uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

	<!-- The material shaders are GLSL ES 300, so the device must have
	     OpenGL ES 3.0. Every Android phone since 2014 does. -->
	<uses-feature android:glEsVersion="0x00030000" android:required="true" />

	<!-- No INTERNET permission: the page is inside the APK, and the
	     WebView is handed every file out of the assets. -->

	<application
		android:label="The Game"
		android:icon="@drawable/icon"
		android:hardwareAccelerated="true"
		android:allowBackup="false">

		<activity
			android:name=".MainActivity"
			android:exported="true"
			android:screenOrientation="sensorLandscape"
			android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity>
	</application>
</manifest>
