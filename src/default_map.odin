package game

import "core:os"

// 1x1 RGBA PNG, pixel 0xFFD57917 (Coalmine key color).
DEFAULT_BIOME_MAP_PNG := [?]u8{
	0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0x00, 0x00, 0x00, 0x0d,
	0x49, 0x48, 0x44, 0x52, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x01,
	0x08, 0x06, 0x00, 0x00, 0x00, 0x1f, 0x15, 0xc4, 0x89, 0x00, 0x00, 0x00,
	0x0d, 0x49, 0x44, 0x41, 0x54, 0x78, 0xda, 0x63, 0xb8, 0x5a, 0x29, 0xfe,
	0x1f, 0x00, 0x05, 0xf1, 0x02, 0x65, 0x0b, 0x2e, 0x5a, 0xb5, 0x00, 0x00,
	0x00, 0x00, 0x49, 0x45, 0x4e, 0x44, 0xae, 0x42, 0x60, 0x82,
}

ensure_default_biome_map :: proc(path: string) -> bool {
	if os.exists(path) {
		return true
	}
	return os.write_entire_file(path, DEFAULT_BIOME_MAP_PNG[:])
}
